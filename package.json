{
  "name": "bcsd-internal-recode",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --port 3000",
    "build": "tsr generate && tsc --noEmit && vite build",
    "start": "vite preview --host 127.0.0.1 --port 3000",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "typecheck": "tsr generate && tsc --noEmit",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "routes:generate": "tsr generate"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.42",
    "@tiptap/extension-image": "^3.30.2",
    "@tiptap/extension-link": "^3.30.2",
    "@tiptap/extension-underline": "^3.30.2",
    "@tiptap/pm": "^3.30.2",
    "@tiptap/react": "^3.30.2",
    "@tiptap/starter-kit": "^3.30.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.46.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.4.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@tanstack/router-cli": "^1.167.41",
    "@tanstack/router-plugin": "^1.168.43",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "oxfmt": "^0.64.0",
    "oxlint": "^1.79.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "packageManager": "pnpm@10.33.0"
}
