{
  // 기존 포맷을 유지하고 KOIN_WEB_RECODE의 import 그룹 정렬을 적용한다.
  "printWidth": 120,
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "arrowParens": "always",
  // prettier-plugin-tailwindcss에 대응한다. 시안과 수치로 맞춰 둔 클래스 순서를
  // 유지해야 하므로 끄지 않는다.
  "sortTailwindcss": {},
  // package.json 키 순서는 건드리지 않는다(prettier도 하지 않았다).
  "sortPackageJson": false,
  "sortImports": {
    "groups": [["builtin", "external"], "internal", ["parent", "sibling", "index"], "unknown"],
    "internalPattern": ["@/"],
    "newlinesBetween": true,
    "sortSideEffects": false
  },
  "ignorePatterns": [
    "dist/**",
    "src/app/router/routeTree.gen.ts",
    "out/**",
    "build/**",
    "pnpm-lock.yaml",
    "와이어프레임 기반 디자인 생성/**"
  ]
}
